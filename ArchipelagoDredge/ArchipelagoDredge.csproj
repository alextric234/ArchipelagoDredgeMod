<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
        <DebugType>portable</DebugType>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
        <DebugType>none</DebugType>
    </PropertyGroup>

    <PropertyGroup>
        <TargetFramework>net48</TargetFramework>
        <LangVersion>latest</LangVersion>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
        <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    </PropertyGroup>

    <!-- The apworld's data files are embedded so the in-game tracker evaluates the same items, locations and hull
         layouts as generation. Override ApWorldDataPath if the apworld isn't checked out next to this repo. -->
    <PropertyGroup>
        <ApWorldDataPath Condition=" '$(ApWorldDataPath)' == '' ">$(MSBuildProjectDirectory)\..\..\ArchipelagoDredge\worlds\dredge\data</ApWorldDataPath>
    </PropertyGroup>

    <ItemGroup>
        <EmbeddedResource Include="$(ApWorldDataPath)\items.json;$(ApWorldDataPath)\locations.json;$(ApWorldDataPath)\hulls.json">
            <LogicalName>ApWorldData.%(Filename)%(Extension)</LogicalName>
        </EmbeddedResource>
    </ItemGroup>

    <Target Name="CheckApWorldData" BeforeTargets="BeforeBuild">
        <Error Condition="!Exists('$(ApWorldDataPath)\locations.json')"
               Text="Couldn't find the apworld data at '$(ApWorldDataPath)'. Check out the ArchipelagoDredge apworld next to this repo or set ApWorldDataPath." />
    </Target>

    <ItemGroup>
        <None Update="Assets\Localization\en.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="default_config.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Include="mod_meta.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Include="Assets\**\*.*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Include="ArchipelagoDredge.csproj.user" />
        <Content Remove="C:\Users\rando\.nuget\packages\\archipelago.multiclient.net\6.7.1\lib\net45\Archipelago.MultiClient.Net.dll" />
        <Content Remove="C:\Users\rando\.nuget\packages\\archipelago.multiclient.net\6.7.1\lib\net45\Archipelago.MultiClient.Net.dll" />
        <Content Include="$(NuGetPackageRoot)\archipelago.multiclient.net\6.7.1\lib\net45\Archipelago.MultiClient.Net.dll" Link="Archipelago.MultiClient.Net.dll">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Archipelago.MultiClient.Net" Version="6.7.1" />
        <PackageReference Include="DredgeGameLibs" Version="1.5.3" />
        <PackageReference Include="HarmonyX" Version="2.10.1" />
        <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
        <PackageReference Include="Winch" Version="0.6.2" />
    </ItemGroup>

    <ItemGroup>
        <Folder Include="Assets\Textures\" />
        <Folder Include="Network\Patches\" />
        <Folder Include="Properties\" />
        <Folder Include="Utils\" />
    </ItemGroup>

</Project>
